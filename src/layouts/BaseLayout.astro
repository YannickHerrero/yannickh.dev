---
import "../styles/global.css";
import { themes } from "../data/themes";
interface Props {
  title: string;
  description?: string;
  desktop?: boolean;
}
const {
  title,
  description = "Yannick Herrero, freelance developer in France. Rust tools, native apps and web experiences. Explore an Illium-inspired desktop portfolio.",
  desktop = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e1e2e" />
    <meta property="og:title" content={`${title} | Yannick Herrero`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Yannick Herrero</title>
    <script
      is:inline
      define:vars={{ themeIds: themes.map((theme) => theme.id) }}
    >
      try {
        const stored = localStorage.getItem("portfolio-theme");
        const theme = stored === "light" ? "latte" : stored;
        document.documentElement.dataset.theme = themeIds.includes(theme)
          ? theme
          : "dark";
        document.documentElement.dataset.opaque =
          localStorage.getItem("portfolio-opaque") === "true"
            ? "true"
            : "false";
      } catch {
        /* Storage may be disabled. The default theme still works. */
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {
      !desktop && (
        <header class="topbar">
          <a class="brand" href="/">
            <span class="accent">▦</span>yannickh.dev
          </a>
          <nav aria-label="Main navigation">
            <>
              <a href="/">Projects</a>
              <a href="/about">About</a>
              <a href="/contact">Contact</a>
            </>
          </nav>
          <div class="topbar-right">
            <a href="/?panel=help">Keyboard help [?]</a>
          </div>
        </header>
      )
    }
    <slot />
    {
      !desktop && (
        <footer class="site-footer">
          Built with Astro. Inspired by{" "}
          <a href="https://github.com/YannickHerrero/illium">Illium</a>.
        </footer>
      )
    }
  </body>
</html>
