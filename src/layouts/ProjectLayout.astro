---
import BaseLayout from "./BaseLayout.astro";
import ProjectContent from "../components/react/ProjectContent";
import { portfolio } from "../data/portfolio";
import type { Project } from "../types";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const curated = portfolio.find(
  (item) => item.repo?.toLowerCase() === project.htmlUrl.toLowerCase()
);
---

<BaseLayout title={project.title} description={project.description}>
  <main id="main-content" class="static-page surface">
    <div class="static-header">
      <span>~/archive/{project.repo}</span><a href="/">Back to desktop ↗</a>
    </div>
    {
      curated ? (
        <ProjectContent project={curated} heading="h1" />
      ) : (
        <div class="project-content">
          <p class="eyebrow">Project archive</p>
          <h1>{project.title}</h1>
          <p class="project-summary">{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="actions">
            <a class="action primary" href={project.htmlUrl}>
              View on GitHub ↗
            </a>
          </div>
        </div>
      )
    }
    <details class="legacy-readme">
      <summary>Repository README</summary><article class="prose">
        <slot />
      </article>
    </details>
  </main>
</BaseLayout>
